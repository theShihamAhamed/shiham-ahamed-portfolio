{
  "name": "@portfolio/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe contracts, schemas, constants, and utilities shared by portfolio applications.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "node ../../scripts/check-package-boundaries.mjs shared",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
