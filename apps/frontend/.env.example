# Public frontend server environment. Keep these values server-only.
# NEXT_PUBLIC_SITE_URL below is intentionally public and contains no secret.
# Required by server-side public repositories.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Public canonical URL used for metadata, sitemap, robots, and JSON-LD.
# Use the final HTTPS portfolio URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional contact form delivery configuration, owned by the frontend server.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Required by the internal backend-to-frontend cache revalidation route.
REVALIDATE_SECRET=<generate-a-long-random-secret>
