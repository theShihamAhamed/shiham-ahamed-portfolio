# Backend runtime configuration. These values are server-only.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
ADMIN_FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
# Temporary convenience for Vercel admin preview deployments. When true, any
# valid HTTPS *.vercel.app origin is allowed by credentialed CORS for the
# entire backend process, including production traffic handled by that process.
ALLOW_VERCEL_PREVIEW_ORIGINS=false
PUBLIC_FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD_HASH=<bcrypt-hash-generated-locally>
JWT_ACCESS_SECRET=<generate-a-long-random-secret>
JWT_REFRESH_SECRET=<generate-a-different-long-random-secret>
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# ImageKit media ownership remains backend-only; upload real media through admin.
IMAGEKIT_PUBLIC_KEY=<imagekit-public-key>
IMAGEKIT_PRIVATE_KEY=<imagekit-private-key>
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<imagekit-id>
MAX_UPLOAD_SIZE_MB=8
# Production requires the exact public frontend endpoint and a matching secret.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=<generate-a-random-secret-at-least-32-characters>

# Refresh-cookie policy. Use SameSite=lax for custom subdomains; use none only
# for provider domains where the admin and API are cross-site.
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# Render runs behind a trusted proxy. Set true only on the deployed backend.
TRUST_PROXY=false
